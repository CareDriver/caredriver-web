# CareDriver web app — environment variables
# Copy this file to .env and fill in the values.
# Next.js exposes only variables prefixed with NEXT_PUBLIC_ to the browser.
# Never commit real secrets.

# -----------------------------------------------------------------------------
# Firebase client config (public, exposed to browser)
# Get these from Firebase Console → Project Settings → General → Web app
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-your-measurement-id

# -----------------------------------------------------------------------------
# Cloud Functions
# Base URL for the new HTTPS Cloud Functions.
# Default: https://us-central1-<NEXT_PUBLIC_FIREBASE_PROJECT_ID>.cloudfunctions.net
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLOUD_FUNCTIONS_BASE_URL=https://us-central1-your-project-id.cloudfunctions.net

# -----------------------------------------------------------------------------
# Firebase App Check (public client key)
# Optional; enables App Check in production.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_APPCHECK_CLIENT_KEY=your-appcheck-client-key

# -----------------------------------------------------------------------------
# Service account (optional)
# Only needed if Next.js runs server-side Firebase Admin SDK.
# The current build is static export, so these are normally not required at runtime.
# -----------------------------------------------------------------------------
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key-here\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------------------------------------
# Debug / build
# -----------------------------------------------------------------------------
# FIREBASE_APPCHECK_DEBUG_TOKEN=true
# NODE_ENV=development
# ANALYZE=true
